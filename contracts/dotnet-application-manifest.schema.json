{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactId", "artifactName", "type", "readiness", "sourceSha", "workflowSha", "governanceVersion", "catalogueVersion", "profileKey", "contractDigest", "dependencyDigest", "sdkVersion", "targetFramework", "runtimeIdentifier", "publishMode", "createdAt", "retentionDays", "files"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "artifactId": {"type": "string", "pattern": "^ART-dotnet-webapi-[a-f0-9]{12}-[a-f0-9]{12}$"},
    "artifactName": {"type": "string", "pattern": "^[a-z0-9-]+_[0-9]+\\.[0-9]+\\.[0-9]+_net10\\.0_linux-x64\\.tar\\.gz$"},
    "type": {"const": "application-package"},
    "readiness": {"const": "ci-qualified"},
    "sourceSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "workflowSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "governanceVersion": {"const": "v1.3.0"},
    "catalogueVersion": {"const": "1.3.0"},
    "profileKey": {"const": "dotnet-webapi"},
    "contractDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "dependencyDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "sdkVersion": {"const": "10.0.110"},
    "targetFramework": {"const": "net10.0"},
    "runtimeIdentifier": {"const": "linux-x64"},
    "publishMode": {"const": "framework-dependent"},
    "createdAt": {"type": "string", "format": "date-time"},
    "retentionDays": {"type": "integer", "minimum": 1, "maximum": 30},
    "files": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["path", "size", "mode", "sha256"], "properties": {
        "path": {"type": "string", "minLength": 1}, "size": {"type": "integer", "minimum": 1},
        "mode": {"enum": ["0644", "0755"]}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }}
    }
  }
}
