{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "governanceVersion", "catalogueVersion", "profileKey",
    "sdkVersion", "targetFramework", "solutionPath", "projectPath",
    "testProjectPath", "artifactName", "applicationVersion",
    "runtimeIdentifier", "publishMode", "coverageThreshold",
    "retentionDays", "evidenceMode", "extensions"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "governanceVersion": {"const": "v1.3.0"},
    "catalogueVersion": {"const": "1.3.0"},
    "profileKey": {"const": "dotnet-webapi"},
    "sdkVersion": {"const": "10.0.110"},
    "targetFramework": {"const": "net10.0"},
    "solutionPath": {"$ref": "#/$defs/relativePath"},
    "projectPath": {"$ref": "#/$defs/relativePath"},
    "testProjectPath": {"$ref": "#/$defs/relativePath"},
    "artifactName": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
    "applicationVersion": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"},
    "runtimeIdentifier": {"const": "linux-x64"},
    "publishMode": {"const": "framework-dependent"},
    "coverageThreshold": {"type": "number", "minimum": 0, "maximum": 100},
    "retentionDays": {"type": "integer", "minimum": 1, "maximum": 30},
    "evidenceMode": {"const": "safe-metadata"},
    "extensions": {"type": "array", "maxItems": 0}
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    }
  }
}
