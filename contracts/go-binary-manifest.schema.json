{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactId", "artifactName", "type", "sourceSha", "workflowSha", "governanceVersion", "catalogueVersion", "profileKey", "contractDigest", "moduleDigest", "goVersion", "target", "createdAt", "retentionDays", "files"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "artifactId": {"type": "string"},
    "artifactName": {"type": "string", "pattern": "^[a-z0-9-]+_[0-9]+\\.[0-9]+\\.[0-9]+_linux_amd64\\.tar\\.gz$"},
    "type": {"const": "binary"},
    "sourceSha": {"pattern": "^[a-f0-9]{40}$"},
    "workflowSha": {"pattern": "^[a-f0-9]{40}$"},
    "governanceVersion": {"const": "v1.2.0"},
    "catalogueVersion": {"const": "1.2.0"},
    "profileKey": {"const": "go-service"},
    "contractDigest": {"pattern": "^sha256:[a-f0-9]{64}$"},
    "moduleDigest": {"pattern": "^sha256:[a-f0-9]{64}$"},
    "goVersion": {"const": "1.26.7"},
    "target": {"const": "linux/amd64"},
    "createdAt": {"type": "string"},
    "retentionDays": {"type": "integer", "minimum": 1, "maximum": 30},
    "files": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "size", "mode", "sha256"], "properties": {"path": {"type": "string"}, "size": {"type": "integer", "minimum": 1}, "mode": {"const": "0755"}, "sha256": {"pattern": "^[a-f0-9]{64}$"}}}}
  }
}
