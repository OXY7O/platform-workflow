{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactId", "artifactName", "type", "sourceSha", "workflowSha", "governanceVersion", "catalogueVersion", "profileKey", "contractDigest", "lockDigest", "createdAt", "retentionDays", "files"],
  "properties": {
    "schemaVersion": {"const": "1.0"}, "artifactId": {"type": "string"}, "artifactName": {"type": "string"},
    "type": {"const": "application-package"}, "sourceSha": {"pattern": "^[a-f0-9]{40}$"}, "workflowSha": {"pattern": "^[a-f0-9]{40}$"},
    "governanceVersion": {"const": "v1.5.1"}, "catalogueVersion": {"const": "1.4.0"}, "profileKey": {"const": "php-laravel"},
    "contractDigest": {"pattern": "^sha256:[a-f0-9]{64}$"}, "lockDigest": {"pattern": "^sha256:[a-f0-9]{64}$"},
    "createdAt": {"type": "string", "format": "date-time"}, "retentionDays": {"type": "integer", "minimum": 1, "maximum": 30},
    "files": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "size", "sha256"], "properties": {"path": {"type": "string"}, "size": {"type": "integer", "minimum": 0}, "sha256": {"pattern": "^[a-f0-9]{64}$"}}}}
  }
}
