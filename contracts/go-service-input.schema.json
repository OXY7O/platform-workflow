{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "governanceVersion", "catalogueVersion", "profileKey",
    "goVersion", "modulePath", "binaryName", "applicationVersion",
    "mainPackage", "artifactType", "targetOs", "targetArch",
    "workingDirectory", "coverageThreshold", "retentionDays", "evidenceMode"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "governanceVersion": {"const": "v1.2.0"},
    "catalogueVersion": {"const": "1.2.0"},
    "profileKey": {"const": "go-service"},
    "goVersion": {"const": "1.26.7"},
    "modulePath": {"type": "string", "pattern": "^[A-Za-z0-9._~-]+(?:/[A-Za-z0-9._~-]+)+$"},
    "binaryName": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
    "applicationVersion": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"},
    "mainPackage": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?:\\.|\\./[A-Za-z0-9._/-]+)$"},
    "artifactType": {"const": "binary"},
    "targetOs": {"const": "linux"},
    "targetArch": {"const": "amd64"},
    "workingDirectory": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?:\\.|[A-Za-z0-9._/-]+)$"},
    "coverageThreshold": {"type": "number", "minimum": 0, "maximum": 100},
    "retentionDays": {"type": "integer", "minimum": 1, "maximum": 30},
    "evidenceMode": {"const": "safe-metadata"}
  }
}
