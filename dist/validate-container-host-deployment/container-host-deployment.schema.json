{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OXY7O/platform-workflow/contracts/container-host-deployment.schema.json",
  "title": "Laravel development container-host deployment contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "governanceVersion", "catalogueVersion", "profileKey", "environment",
    "targetId", "sourceSha", "workflowSha", "artifactId", "imageReference", "imageDigest",
    "composePath", "services", "healthPath", "healthTimeoutSeconds", "healthRetries",
    "lkgImageDigest", "promotionReference", "evidenceMode"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "governanceVersion": {"const": "v1.5.0"},
    "catalogueVersion": {"const": "1.2.0"},
    "profileKey": {"const": "php-laravel"},
    "environment": {"const": "development"},
    "targetId": {"const": "laravel-development-container-host"},
    "sourceSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "workflowSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "artifactId": {"type": "string", "pattern": "^ART-[A-Z0-9]+-[0-9]{8}-[0-9]{4,}$"},
    "imageReference": {"type": "string", "pattern": "^[a-z0-9.-]+(?::[0-9]+)?/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$"},
    "imageDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "composePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+\\.ya?ml$"
    },
    "services": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["web", "queue", "scheduler"]},
      "contains": {"const": "web"}
    },
    "healthPath": {"const": "/up"},
    "healthTimeoutSeconds": {"type": "integer", "minimum": 10, "maximum": 300},
    "healthRetries": {"type": "integer", "minimum": 1, "maximum": 30},
    "lkgImageDigest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "promotionReference": {"type": ["string", "null"], "pattern": "^PMR-[A-Z0-9-]{8,80}$"},
    "evidenceMode": {"const": "safe-metadata"}
  }
}
