{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["publishDirectory", "outputDirectory", "artifactName", "applicationVersion", "sourceSha", "workflowSha", "contractDigest", "dependencyDigest", "sdkVersion", "targetFramework", "runtimeIdentifier", "publishMode", "retentionDays"],
  "properties": {
    "publishDirectory": {"type": "string", "minLength": 1},
    "outputDirectory": {"type": "string", "minLength": 1},
    "artifactName": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
    "applicationVersion": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"},
    "sourceSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "workflowSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "contractDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "dependencyDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "sdkVersion": {"const": "10.0.110"},
    "targetFramework": {"const": "net10.0"},
    "runtimeIdentifier": {"const": "linux-x64"},
    "publishMode": {"const": "framework-dependent"},
    "retentionDays": {"type": "integer", "minimum": 1, "maximum": 30},
    "createdAt": {"type": "string", "format": "date-time"}
  }
}
