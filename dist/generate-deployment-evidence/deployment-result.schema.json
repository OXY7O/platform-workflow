{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OXY7O/platform-workflow/contracts/deployment-result.schema.json",
  "title": "Safe deployment evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["attemptId", "repository", "environment", "targetId", "sourceSha", "workflowSha", "artifactId", "imageDigest", "authorizationReference", "startedAt", "completedAt", "terminalStatus", "failureCategory", "healthStatus", "previousLkgDigest", "resultingLkgDigest", "rollbackStatus", "governanceVersion", "contractDigest"],
  "properties": {
    "attemptId": {"type": "string", "pattern": "^DPA-[0-9]{8}-[0-9]{4,}$"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "environment": {"const": "development"},
    "targetId": {"const": "laravel-development-container-host"},
    "sourceSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "workflowSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "artifactId": {"type": "string", "pattern": "^ART-[A-Z0-9]+-[0-9]{8}-[0-9]{4,}$"},
    "imageDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "authorizationReference": {"type": "string", "pattern": "^ENV-[A-Z0-9-]{8,80}$"},
    "startedAt": {"type": "string", "format": "date-time"},
    "completedAt": {"type": "string", "format": "date-time"},
    "terminalStatus": {"enum": ["succeeded", "failed"]},
    "failureCategory": {"type": ["string", "null"], "enum": [null, "authorization", "contract", "pull", "compose", "health", "rollback", "platform"]},
    "healthStatus": {"enum": ["healthy", "unhealthy", "not-run"]},
    "previousLkgDigest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "resultingLkgDigest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "rollbackStatus": {"enum": ["not-required", "succeeded", "failed", "unavailable"]},
    "governanceVersion": {"const": "v1.5.0"},
    "contractDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
